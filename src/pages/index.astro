---
import Layout from '../layouts/Layout.astro';
import HeroSequence from '../components/HeroSequence.vue';
import BubbleCursor from '../components/BubbleCursor.vue';
import ServiceShowcase from '../components/ServiceShowcase.vue';
---

<Layout>
  <!-- 1. HERO SECTION (CINEMATIC FRAME) -->
  <section class="section hero">
    <div class="hero-video-frame">
      <video id="heroVideo" src="/hero_dog.mp4" autoplay loop muted playsinline></video>
      <div class="overlay"></div>
      
      <!-- Audio Toggle Button -->
      <button id="audioToggle" class="audio-toggle-btn" aria-label="Toggle Audio">
        <svg id="iconMuted" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <line x1="23" y1="9" x2="17" y2="15"></line>
          <line x1="17" y1="9" x2="23" y2="15"></line>
        </svg>
        <svg id="iconUnmuted" style="display: none;" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
        </svg>
      </button>
    </div>
    
    <div class="hero-content">
      <h1 class="tagline">Oltre l'Algoritmo.<br>Intelligenze che Connettono.</h1>
    </div>
    
    <div class="scroll-indicator">
      <p>Scopri il nostro approccio</p>
      <div class="indicator-line"></div>
    </div>
  </section>

  <!-- 2. FEATURES/PILLARS SECTION (CON SFONDO NEURALE) -->
  <section class="section pillars">
    <div class="pillars-bg-wrapper">
      <HeroSequence client:load />
    </div>
    
    <div class="container relative-content">
      <div class="horizontal-pillars">
        <!-- Pillar 01 -->
        <div class="pillar" data-drawer-title="Architetture Web Sostenibili" data-drawer-body="La nostra progettazione si basa sull'ottimizzazione estrema delle performance. Scriviamo codice pulito e leggero che riduce drasticamente il carico sui server e, di conseguenza, le emissioni di CO2 legate al traffico dati. Le nostre piattaforme sono pensate per durare nel tempo, essere accessibili su qualsiasi dispositivo e caricarsi istantaneamente, offrendo un'esperienza utente premium senza sprechi energetici.">
          <div class="pillar-number">01</div>
          <h3>Architetture Sostenibili</h3>
          <p>Sviluppiamo piattaforme leggere e performanti per ridurre l'impatto energetico.</p>
        </div>
        
        <!-- Pillar 02 -->
        <div class="pillar" data-drawer-title="Intelligenza Artificiale Etica" data-drawer-body="Non crediamo nell'uso dell'IA come scatola nera. Sviluppiamo e integriamo modelli di machine learning trasparenti e addestrati su dati curati e consensuali. I nostri sistemi IA sono progettati per assistere compiti specifici (come analisi dei dati, automazione del supporto o personalizzazione) senza mai ricorrere a pratiche di sorveglianza, profilazione occulta o estrazione predatoria dei dati.">
          <div class="pillar-number">02</div>
          <h3>IA Etica e Trasparente</h3>
          <p>Modelli addestrati responsabilmente, senza profilazione o estrazione predatoria.</p>
        </div>
        
        <!-- Pillar 03 -->
        <div class="pillar" data-drawer-title="Interfacce a Misura d'Uomo" data-drawer-body="Rifiutiamo categoricamente l'uso di Dark Pattern (trucchi psicologici per ingannare l'utente) e logiche di 'engagement' tossico mirate a creare dipendenza. Le nostre interfacce sono disegnate per essere chiare, oneste e rispettose del tuo tempo. Crediamo in un design che facilita la vita delle persone, permettendo loro di compiere le azioni desiderate nel minor tempo possibile e con la massima serenità.">
          <div class="pillar-number">03</div>
          <h3>Design a Misura d'Uomo</h3>
          <p>Interfacce oneste, libere da dark pattern, progettate per farti risparmiare tempo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PRODUCT SHOWCASE SECTION -->
  <section class="section product-showcase">
    <div class="container">
      <h2>Le Nostre Soluzioni</h2>
      <ServiceShowcase client:load />
    </div>
  </section>

  <!-- 5. BRAND STORY SECTION (BOLLE) -->
  <section class="section brand-story">
    <div class="video-bg-container">
      <video class="story-video-bg" src="/animated_bobbles.mp4" autoplay loop muted playsinline></video>
      <div class="video-overlay"></div>
    </div>
    <div class="container relative-content">
      <div class="story-text-center">
        <h2>La nostra etica digitale</h2>
        <p>Progettiamo spazi web radicali: architetture tecnologiche che non sfruttano, ma arricchiscono le comunità.</p>
        <p>In un mondo guidato dall'astrazione, riportiamo l'attenzione sulla singolarità delle relazioni, sfidando l'ottimizzazione sfrenata.</p>
      </div>
    </div>
    
    <!-- BubbleCursor Overlay indipendente (non rompe GSAP né CSS) -->
    <BubbleCursor client:load />
  </section>

  <!-- 5. CALL TO ACTION SECTION -->
  <section class="section cta">
    <div class="container">
      <h2>Costruiamo insieme.</h2>
      <p>Entra a far parte di un ecosistema che ridefinisce le regole del gioco.</p>
      <div class="signup-form">
        <input type="email" placeholder="Il tuo indirizzo email" />
        <button type="submit">Unisciti al network</button>
      </div>
    </div>
  </section>

  <!-- 6. FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div class="logo">Ecosistemi Relazionali</div>
        <div class="links">
          <a href="#">Manifesto</a>
          <a href="#">Pratiche</a>
          <a href="#">Visione</a>
        </div>
        <div class="socials">
          <a href="#">Twitter</a>
          <a href="#">Instagram</a>
          <a href="#">LinkedIn</a>
        </div>
      </div>
      <div class="copyright">
        © 2026 Ecosistemi Relazionali. Nessun diritto riservato.
      </div>
    </div>
  </footer>

  <!-- SIDE DRAWER OVERLAY & PANEL -->
  <div class="drawer-overlay" id="drawerOverlay"></div>
  <div class="side-drawer" id="sideDrawer">
    <div class="drawer-header">
      <h2 id="drawerTitle">Titolo</h2>
      <button class="drawer-close" id="drawerClose">✕</button>
    </div>
    <div class="drawer-body">
      <p id="drawerBodyText">Contenuto...</p>
    </div>
  </div>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
      const storyElements = document.querySelectorAll('.story-text-center > *');
      
      if (storyElements.length > 0) {
        gsap.fromTo(storyElements, 
          { y: 50, opacity: 0 },
          {
            scrollTrigger: {
              trigger: '.brand-story',
              start: 'top 85%', 
              toggleActions: 'play none none reverse',
            },
            y: 0,
            opacity: 1,
            duration: 1,
            stagger: 0.15,
            ease: 'power3.out'
          }
        );
      }

      // DRAWER LOGIC
      const pillars = document.querySelectorAll('.pillar');
      const drawer = document.getElementById('sideDrawer');
      const overlay = document.getElementById('drawerOverlay');
      const closeBtn = document.getElementById('drawerClose');
      const drawerTitle = document.getElementById('drawerTitle');
      const drawerBodyText = document.getElementById('drawerBodyText');

      function openDrawer(title, body) {
        drawerTitle.textContent = title;
        drawerBodyText.textContent = body;
        drawer.classList.add('open');
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden'; // Evita scroll di pagina
      }

      function closeDrawer() {
        drawer.classList.remove('open');
        overlay.classList.remove('open');
        document.body.style.overflow = '';
      }

      pillars.forEach(pillar => {
        pillar.addEventListener('click', () => {
          const title = pillar.getAttribute('data-drawer-title');
          const body = pillar.getAttribute('data-drawer-body');
          if (title && body) openDrawer(title, body);
        });
      });

      closeBtn.addEventListener('click', closeDrawer);
      overlay.addEventListener('click', closeDrawer);
      // AUDIO TOGGLE LOGIC
      const heroVideo = document.getElementById('heroVideo');
      const audioToggle = document.getElementById('audioToggle');
      const iconMuted = document.getElementById('iconMuted');
      const iconUnmuted = document.getElementById('iconUnmuted');

      if (heroVideo && audioToggle) {
        audioToggle.addEventListener('click', () => {
          if (heroVideo.muted) {
            heroVideo.muted = false;
            iconMuted.style.display = 'none';
            iconUnmuted.style.display = 'block';
          } else {
            heroVideo.muted = true;
            iconMuted.style.display = 'block';
            iconUnmuted.style.display = 'none';
          }
        });
      }

    });
  </script>
</Layout>
